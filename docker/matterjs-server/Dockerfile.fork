# Production image for the fork. The official production Dockerfile installs
# matter-server from npm and therefore cannot deliver this fork; this variant
# builds from source in a builder stage and ships a clean runtime stage that
# mirrors the official image's runtime shape (user, healthcheck, entrypoint).

FROM node:24.15-trixie-slim AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Toolchain for native module compilation (builder stage only).
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        python3 \
        make \
        gcc \
        g++ \
        libbluetooth-dev \
        libudev-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./
COPY tsc ./tsc/
COPY packages/custom-clusters/package*.json ./packages/custom-clusters/
COPY packages/ws-controller/package*.json ./packages/ws-controller/
COPY packages/ws-client/package*.json ./packages/ws-client/
COPY packages/dashboard/package*.json ./packages/dashboard/
COPY packages/ble-proxy/package*.json ./packages/ble-proxy/
COPY packages/matter-server/package*.json ./packages/matter-server/

# --ignore-scripts: the root `prepare` script needs source that is only copied below.
RUN npm ci --ignore-scripts

COPY . .

# Apply the @matter/node keepalive-liveness patch, compile native modules, build,
# then drop development dependencies from node_modules for the runtime copy.
RUN npx patch-package --error-on-fail \
    && npm rebuild --foreground-scripts \
    && npm run build \
    && npm prune --omit=dev


FROM node:24.15-trixie-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Runtime dependencies only. setcap grants ping CAP_NET_RAW for the non-root
# user, then libcap2-bin is purged (matches the official production image).
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        iputils-ping \
        curl \
        bluez \
        libcap2-bin \
    && setcap cap_net_raw+ep "$(command -v ping)" \
    && apt-get purge -y --auto-remove libcap2-bin \
    && rm -rf /var/lib/apt/lists/* /usr/src/* \
    && mkdir /data \
    && chown 1000:1000 /data

WORKDIR /app

# Workspace layout including the node_modules/matter-server symlink the HAOS
# wrapper's run script resolves; dev dependencies were pruned in the builder.
COPY --from=builder /app /app

ENV LOG_LEVEL=info
ENV STORAGE_PATH=/data

VOLUME ["/data"]

EXPOSE 5580

COPY --chmod=0755 docker/matterjs-server/healthcheck.sh /usr/local/bin/healthcheck.sh

# Long start period: a first-start storage migration must not be killed by
# container watchdogs (matches the official production image).
HEALTHCHECK --interval=60s --timeout=10s --start-period=900s --start-interval=5s --retries=6 \
    CMD ["/usr/local/bin/healthcheck.sh"]

USER 1000:1000

ENTRYPOINT ["node", "--enable-source-maps", "packages/matter-server/dist/esm/MatterServer.js"]
CMD []
